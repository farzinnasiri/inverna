{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "moduleSuffixes": [".native", ""],
    "types": ["react", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/core/**/*.ts",
    "src/design/**/*.ts",
    "src/platform/**/*.ts",
    "src/ui/rn/**/*.ts",
    "src/ui/rn/**/*.tsx",
    "src/ui/hooks/useTokenColors.ts",
    "src/ui/state/**/*.ts",
    "app.config.ts"
  ]
}
