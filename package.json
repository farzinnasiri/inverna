{
  "name": "inverna",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "expo start --lan",
    "dev": "node scripts/dev-portless.mjs",
    "dev:portless": "node scripts/dev-portless.mjs",
    "web": "expo start --web --lan",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node scripts/export-web.mjs",
    "deploy": "pnpm build && npx wrangler deploy",
    "doctor": "pnpm dlx expo-doctor",
    "postinstall": "setup-skia-web public"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.21",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^6.5.1",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.3",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "^1.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.11"
  }
}
